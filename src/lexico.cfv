// lexico.cfv — Analizador léxico para lenguajes con sintaxis tipo C:
// C++, Swift, JavaScript, TypeScript y C-Forge.
//
// Devuelve un mapa con listas paralelas (más rápido que una lista de mapas):
//   tipos:  "id" | "num" | "texto" | "op"
//   textos: el texto del token (para "texto", el contenido sin comillas)
//   lineas: número de línea (desde 1)
//   interp: para "texto", verdadero si tiene interpolación (${…} o \(…))
// Los comentarios se descartan, pero se recuerda en qué líneas aparece
// "vsr:ignorar" para poder silenciar hallazgos en esa línea.

funcion _es_letra(b) {
    retornar (b >= 97 y b <= 122) o (b >= 65 y b <= 90) o b == 95 o b == 36 o b >= 128
}

funcion _es_digito(b) {
    retornar b >= 48 y b <= 57
}

funcion _es_espacio(b) {
    retornar b == 32 o b == 9 o b == 13 o b == 10
}

// Operadores de dos o tres caracteres que importan para el análisis.
funcion _op_largo(txt, i, n) {
    si (i + 2 < n) {
        sea t3 = subtexto(txt, i, i + 3)
        si (t3 == "===" o t3 == "!==" o t3 == "..." o t3 == "<<=" o t3 == ">>=" o t3 == "?.(") { retornar 3 }
    }
    si (i + 1 < n) {
        sea t2 = subtexto(txt, i, i + 2)
        si (t2 == "==" o t2 == "!=" o t2 == "<=" o t2 == ">=" o t2 == "&&" o t2 == "||" o t2 == "+=" o t2 == "-=" o t2 == "->" o t2 == "=>" o t2 == "::" o t2 == "?." o t2 == "??" o t2 == "<<" o t2 == ">>" o t2 == "++" o t2 == "--") { retornar 2 }
    }
    retornar 1
}

funcion lexico(txt) {
    sea tipos = []
    sea textos = []
    sea lineas = []
    sea interp = []
    sea ignorar = {}
    sea n = longitud(txt)
    sea i = 0
    sea linea = 1
    mientras (i < n) {
        sea b = byte_en(txt, i)
        si (b == 10) {
            linea = linea + 1
            i = i + 1
            continuar
        }
        si (_es_espacio(b)) {
            i = i + 1
            continuar
        }
        // Comentario de línea //
        si (b == 47 y i + 1 < n y byte_en(txt, i + 1) == 47) {
            sea fin = texto_indice_desde(txt, "\n", i)
            si (fin < 0) { fin = n }
            si (texto_indice(subtexto(txt, i, fin), "vsr:ignorar") >= 0) { ignorar[numero_a_texto(linea)] = verdadero }
            i = fin
            continuar
        }
        // Comentario de bloque /* */
        si (b == 47 y i + 1 < n y byte_en(txt, i + 1) == 42) {
            sea fin = texto_indice_desde(txt, "*/", i + 2)
            si (fin < 0) { fin = n } sino { fin = fin + 2 }
            sea j = i
            mientras (j < fin) {
                si (byte_en(txt, j) == 10) { linea = linea + 1 }
                j = j + 1
            }
            i = fin
            continuar
        }
        // Comentario # al inicio de línea en C-Forge no existe; en C++ es
        // preprocesador: se trata como operador para no perder #include.
        // Textos: " ' ` y Swift """
        si (b == 34 o b == 39 o b == 96) {
            sea inicio_linea = linea
            sea triple = falso
            si (b == 34 y i + 2 < n y byte_en(txt, i + 1) == 34 y byte_en(txt, i + 2) == 34) { triple = verdadero }
            sea j = i + 1
            si (triple) { j = i + 3 }
            sea tiene_interp = falso
            mientras (j < n) {
                sea c = byte_en(txt, j)
                si (c == 92) {
                    // \( interpolación de Swift
                    si (j + 1 < n y byte_en(txt, j + 1) == 40) { tiene_interp = verdadero }
                    j = j + 2
                    continuar
                }
                si (c == 10) {
                    linea = linea + 1
                    // Los textos normales no cruzan líneas (salvo ` y """).
                    si (b != 96 y triple == falso) { romper }
                }
                si (b == 96 y c == 36 y j + 1 < n y byte_en(txt, j + 1) == 123) { tiene_interp = verdadero }
                si (triple) {
                    si (c == 34 y j + 2 < n y byte_en(txt, j + 1) == 34 y byte_en(txt, j + 2) == 34) {
                        j = j + 3
                        romper
                    }
                } sino {
                    si (c == b) {
                        j = j + 1
                        romper
                    }
                }
                j = j + 1
            }
            sea desde = i + 1
            sea hasta = j - 1
            si (triple) {
                desde = i + 3
                hasta = j - 3
            }
            si (hasta < desde) { hasta = desde }
            si (hasta > n) { hasta = n }
            agregar(tipos, "texto")
            agregar(textos, subtexto(txt, desde, hasta))
            agregar(lineas, inicio_linea)
            agregar(interp, tiene_interp)
            i = j
            continuar
        }
        si (_es_letra(b)) {
            sea j = i + 1
            mientras (j < n) {
                sea c = byte_en(txt, j)
                si (_es_letra(c) o _es_digito(c)) { j = j + 1 } sino { romper }
            }
            agregar(tipos, "id")
            agregar(textos, subtexto(txt, i, j))
            agregar(lineas, linea)
            agregar(interp, falso)
            i = j
            continuar
        }
        si (_es_digito(b)) {
            sea j = i + 1
            mientras (j < n) {
                sea c = byte_en(txt, j)
                si (_es_letra(c) o _es_digito(c) o c == 46) { j = j + 1 } sino { romper }
            }
            agregar(tipos, "num")
            agregar(textos, subtexto(txt, i, j))
            agregar(lineas, linea)
            agregar(interp, falso)
            i = j
            continuar
        }
        sea largo = _op_largo(txt, i, n)
        agregar(tipos, "op")
        agregar(textos, subtexto(txt, i, i + largo))
        agregar(lineas, linea)
        agregar(interp, falso)
        i = i + largo
    }
    retornar {"tipos": tipos, "textos": textos, "lineas": lineas, "interp": interp, "ignorar": ignorar, "total_lineas": linea}
}
