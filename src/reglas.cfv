funcion lenguaje_de(ruta) {
    sea ext = texto_minusculas(ruta_extension(ruta))
    si (ext == ".js" o ext == ".mjs" o ext == ".cjs" o ext == ".jsx" o ext == ".ts" o ext == ".tsx" o ext == ".mts" o ext == ".cts" o ext == ".vue" o ext == ".svelte") { retornar "js" }
    si (ext == ".swift") { retornar "swift" }
    si (ext == ".cpp" o ext == ".cc" o ext == ".cxx" o ext == ".c" o ext == ".h" o ext == ".hpp" o ext == ".hh" o ext == ".hxx" o ext == ".mm" o ext == ".m") { retornar "cpp" }
    si (ext == ".cfv") { retornar "cforge" }
    si (ext == ".plist") { retornar "plist" }
    retornar nulo
}
