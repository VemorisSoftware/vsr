        "arreglo_es": "Elimina eval/Function; usa JSON.parse, un mapa de funciones permitidas o un parser.",
        "arreglo_en": "Remove eval/Function; use JSON.parse, an allow-listed function map or a parser."
    },
    "recorrido-rutas": {
        "severidad": "alta",
        "es": "Una ruta de archivo se arma con datos externos: permite leer o escribir fuera de la carpeta prevista (path traversal).",
        "en": "A file path is built from external data: allows reading or writing outside the intended folder (path traversal).",
        "arreglo_es": "Normaliza la ruta, verifica que quede dentro de la carpeta permitida y rechaza '..'.",
        "arreglo_en": "Normalize the path, check it stays inside the allowed folder and reject '..'."
    },
    "ssrf": {
        "severidad": "alta",
        "es": "Se hace una petición de red a una dirección que controla el usuario (SSRF).",
        "en": "A network request is made to an address controlled by the user (SSRF).",
        "arreglo_es": "Valida el host contra una lista permitida y bloquea direcciones internas (127.0.0.1, 169.254.x, 10.x…).",
        "arreglo_en": "Validate the host against an allow-list and block internal addresses (127.0.0.1, 169.254.x, 10.x…)."
    },
    "redireccion-abierta": {
        "severidad": "media",
        "es": "Se redirige a una URL que controla el usuario (redirección abierta).",
        "en": "Redirect to a user-controlled URL (open redirect).",
        "arreglo_es": "Redirige solo a rutas internas o a una lista de destinos permitidos.",
        "arreglo_en": "Only redirect to internal paths or an allow-list of destinations."
    },
    "desbordamiento-memoria": {
        "severidad": "critica",
        "es": "Función de C sin límite de tamaño: puede desbordar el búfer.",
        "en": "Unbounded C function: can overflow the buffer.",
        "arreglo_es": "Usa std::string, snprintf o strlcpy/strlcat con el tamaño del destino.",
        "arreglo_en": "Use std::string, snprintf or strlcpy/strlcat with the destination size."
    },
    "cadena-formato": {
        "severidad": "alta",
        "es": "El formato de printf no es literal: un atacante puede leer o escribir memoria (format string).",
        "en": "printf format is not a literal: an attacker can read or write memory (format string).",
        "arreglo_es": "Usa un formato fijo: printf(\"%s\", valor).",
        "arreglo_en": "Use a fixed format: printf(\"%s\", value)."
    },
    "secreto-expuesto": {
        "severidad": "critica",
        "es": "Hay una clave o credencial escrita en el código.",
        "en": "A key or credential is written in the code.",
        "arreglo_es": "Muévela a una variable de entorno o gestor de secretos y rótala: ya debe considerarse comprometida.",
        "arreglo_en": "Move it to an environment variable or secrets manager and rotate it: consider it compromised."
    },
    "tls-desactivado": {
        "severidad": "alta",
        "es": "Se desactiva la verificación de certificados TLS: permite ataques de intermediario.",
        "en": "TLS certificate verification is disabled: allows man-in-the-middle attacks.",
        "arreglo_es": "Deja activa la verificación; para certificados propios, agrega la CA de confianza.",
        "arreglo_en": "Keep verification on; for self-signed certificates, add the trusted CA."
    },
    "almacenamiento-inseguro": {
        "severidad": "media",
        "es": "Se guarda un dato sensible en un almacenamiento sin cifrar.",
        "en": "Sensitive data is stored in unencrypted storage.",
        "arreglo_es": "Usa el Llavero (Keychain) para tokens y contraseñas.",
        "arreglo_en": "Use the Keychain for tokens and passwords."
    },
    "hash-debil": {
        "severidad": "baja",
        "es": "Se usa MD5 o SHA-1, que no son seguros para contraseñas ni firmas.",
        "en": "MD5 or SHA-1 is used; they are not safe for passwords or signatures.",
        "arreglo_es": "Contraseñas: argon2id o bcrypt. Integridad: SHA-256 o superior.",
        "arreglo_en": "Passwords: argon2id or bcrypt. Integrity: SHA-256 or better."
    },
    "aleatorio-inseguro": {
        "severidad": "media",
        "es": "Se usa un generador aleatorio no criptográfico para un valor de seguridad.",
        "en": "A non-cryptographic random generator is used for a security value.",
        "arreglo_es": "Usa crypto.getRandomValues / randomBytes / SecRandomCopyBytes / crypto_rand_bytes.",
        "arreglo_en": "Use crypto.getRandomValues / randomBytes / SecRandomCopyBytes / crypto_rand_bytes."
    },
    "regex-dinamica": {
        "severidad": "baja",
        "es": "Se crea una expresión regular con datos del usuario: posible ReDoS.",
        "en": "A regular expression is built from user data: possible ReDoS.",
        "arreglo_es": "Escapa el texto antes de usarlo en la regex o limita su largo.",
        "arreglo_en": "Escape the text before using it in the regex or limit its length."
    },
    "ats-desactivado": {
        "severidad": "media",
        "es": "App Transport Security permite conexiones HTTP sin cifrar.",
        "en": "App Transport Security allows unencrypted HTTP connections.",
        "arreglo_es": "Elimina NSAllowsArbitraryLoads; si un dominio lo requiere, usa una excepción solo para ese dominio.",
        "arreglo_en": "Remove NSAllowsArbitraryLoads; if a domain needs it, add an exception for that domain only."
    }
}

