// reglas.cfv — Catálogo de reglas de Vemoris Security Review.
//
// Cada lenguaje define:
//   fuentes:      prefijos de cadenas (obj.prop) que traen datos externos
//   llamadas_fuente: funciones que devuelven datos externos
//   limpiadores:  funciones que validan o escapan un dato
//   sumideros:    funciones peligrosas -> regla y modo
//                 modo "dato":    alerta si recibe un dato externo
//                 modo "armado":  alerta si recibe algo que no es literal
//                                 (alta si es dato externo, media si no)
//                 modo "sql":     alerta si arma SQL concatenando o interpolando
//                 modo "siempre": la función es insegura en sí misma
//                 3er elemento opcional: la cadena debe contener ese texto
//                 (p. ej. "document" para document.write)
//   asignaciones: propiedades peligrosas al asignarles un valor (innerHTML…)
//
// Las reglas (id) se describen en REGLAS con severidad, mensajes y arreglos
// en español e inglés.

sea REGLAS = {
    "inyeccion-comandos": {
        "severidad": "critica",
        "es": "Un dato externo llega a un comando del sistema: permite ejecutar comandos arbitrarios.",
        "en": "External data reaches a system command: allows arbitrary command execution.",
        "arreglo_es": "No uses el shell. Pasa los argumentos como lista a una función que no invoque al shell y valida contra una lista permitida.",
        "arreglo_en": "Avoid the shell. Pass arguments as a list to a function that doesn't invoke a shell and validate against an allow-list."
    },
    "inyeccion-sql": {
        "severidad": "critica",
        "es": "La consulta SQL se arma concatenando o interpolando valores: riesgo de inyección SQL.",
        "en": "The SQL query is built by concatenation or interpolation: SQL injection risk.",
        "arreglo_es": "Usa consultas parametrizadas (?, $1) y pasa los valores aparte.",
        "arreglo_en": "Use parameterized queries (?, $1) and pass values separately."
    },
    "xss": {
        "severidad": "alta",
        "es": "Se inserta HTML con datos que pueden venir del usuario: riesgo de XSS.",
        "en": "HTML is inserted with data that may come from the user: XSS risk.",
        "arreglo_es": "Usa textContent o el escapado del framework; si necesitas HTML, sanitízalo (DOMPurify).",
        "arreglo_en": "Use textContent or the framework's escaping; if HTML is needed, sanitize it (DOMPurify)."
    },
    "codigo-dinamico": {
        "severidad": "alta",
        "es": "Se ejecuta código construido en tiempo de ejecución (eval o similar).",
